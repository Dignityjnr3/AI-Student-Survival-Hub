{
  "entities": {
    "UserProfile": {
      "title": "User Profile",
      "description": "Stores user information and roles",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string", "enum": ["admin", "lecturer", "student"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "name", "email", "role"]
    },
    "Course": {
      "title": "Course",
      "description": "Academic courses created by lecturers",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "lecturerId": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "lecturerId", "title"]
    },
    "Assignment": {
      "title": "Assignment",
      "description": "Tasks assigned within a course",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "courseId": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "deadline": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "courseId", "title", "deadline"]
    },
    "Submission": {
      "title": "Submission",
      "description": "Student progress and work on assignments",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "assignmentId": { "type": "string" },
        "studentId": { "type": "string" },
        "lecturerId": { "type": "string" },
        "studentName": { "type": "string" },
        "type": { "type": "string", "enum": ["text", "file"] },
        "content": { "type": "string" },
        "fileUrl": { "type": "string" },
        "fileName": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "submitted", "graded"] },
        "grade": { "type": "string" },
        "feedback": { "type": "string" },
        "plan": { "type": "object" },
        "completedAt": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "assignmentId", "studentId", "lecturerId", "status", "type"]
    },
    "Attendance": {
      "title": "Attendance",
      "description": "Student attendance records",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "studentId": { "type": "string" },
        "studentName": { "type": "string" },
        "courseId": { "type": "string" },
        "lecturerId": { "type": "string" },
        "date": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "status": { "type": "string", "enum": ["present", "absent"] }
      },
      "required": ["id", "studentId", "courseId", "lecturerId", "date", "status"]
    }
  },
  "firestore": {
    "/users/{uid}": {
      "schema": "UserProfile",
      "description": "User profiles"
    },
    "/courses/{courseId}": {
      "schema": "Course",
      "description": "Courses"
    },
    "/assignments/{assignmentId}": {
      "schema": "Assignment",
      "description": "Assignments"
    },
    "/submissions/{submissionId}": {
      "schema": "Submission",
      "description": "Student submissions and plans"
    },
    "/attendance/{attendanceId}": {
      "schema": "Attendance",
      "description": "Attendance records"
    }
  }
}
